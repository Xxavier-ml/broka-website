# The BROKA API the auctions and online stores are read from. Server side only:
# the browser never calls it, so there is nothing to expose and no CORS to set up.
# Defaults to the production API (the Azure Container App). Render
# (https://broka-dbjd.onrender.com) is the fallback: set it here and redeploy.
BROKA_API_URL=

# The web storefront: the main repository's web/, deployed as its own Vercel
# project (Root Directory "web"). Its own address, e.g.
# https://broka-store.vercel.app. Every store link the app shares
# (broka.co.ke/store/<name>) is passed on to it, with its link previews and
# app-link files. Unset, this site shows those links with its own store pages
# instead. Read at build time: redeploy after changing it.
STOREFRONT_URL=

# Shared with the storefront's Vercel project (its STOREFRONT_PROXY_KEY): the
# same 32+ random characters in both. Lets this site tell the storefront each
# visitor's address, so a store's visit counts are limited per visitor, not
# per server of this site. Server side only - never NEXT_PUBLIC_.
STOREFRONT_PROXY_KEY=

# Where "Get the app" goes. Defaults to the latest APK on the BROKA repository's
# GitHub releases; set it to a Play Store link once there is one.
NEXT_PUBLIC_APP_DOWNLOAD_URL=

# Not used yet (the website reads the API on the server, via BROKA_API_URL).
NEXT_PUBLIC_API_BASE_URL=
